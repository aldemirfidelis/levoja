  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Indicadores: visitas às lojas (taxa de conversão), sem identificar o visitante
// -----------------------------------------------------------------------------

model StoreVisitDaily {
  companyId String   @db.Uuid
  /// Dia local da loja (fuso da empresa).
  day       DateTime @db.Date
  visits    Int      @default(0)

  @@id([companyId, day])
  @@map("store_visits_daily")
}

// =============================================================================
// FASE 7 — B2B (CORPORATIVO)
// =============================================================================

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ENDED
}

/// Contrato corporativo: habilita entregas faturadas com limite de crédito, tabela especial,
/// franquia mínima, centros de custo obrigatórios e fatura mensal.
model CorporateContract {
  id                    String         @id @default(uuid(7)) @db.Uuid
  tenantId              String         @db.Uuid
  companyId             String         @db.Uuid
  number                Int
  title                 String
  status                ContractStatus @default(DRAFT)
  startsOn              DateTime       @db.Date
  endsOn                DateTime?      @db.Date
  /// Dia de fechamento (1–28): a fatura cobre do fechamento anterior até a véspera.
  billingDay            Int            @default(1)
  paymentTermDays       Int            @default(10)
  /// Máximo em aberto (entregas faturadas ainda não pagas).
  creditLimitCents      Int
  /// Franquia mínima mensal: o complemento é cobrado na fatura.
  minimumMonthlyCents   Int            @default(0)
  /// Desconto sobre a tabela padrão quando nenhuma regra especial se aplica (pontos-base).
  discountBps           Int            @default(0)
  requireCostCenter     Boolean        @default(false)
  /// Avisar os destinatários (SMS) com o link de acompanhamento.
  notifyRecipients      Boolean        @default(true)
  /// Fatura vencida há mais dias que isto bloqueia novas entregas faturadas.
  blockAfterOverdueDays Int            @default(5)
  notes                 String?
  createdById           String         @db.Uuid
  activatedAt           DateTime?
  activatedById         String?        @db.Uuid
  endedAt               DateTime?
  /// Fim (exclusivo) do período da última fatura emitida.
  invoicedUntil         DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  company    Company             @relation(fields: [companyId], references: [id])
  priceRules ContractPriceRule[]
  invoices   Invoice[]

  @@unique([tenantId, number])
  @@index([companyId, status])
  @@map("corporate_contracts")
}

/// Tabela especial do contrato (mesmo motor da tabela padrão, sem adicional de demanda).
model ContractPriceRule {
  id                String       @id @default(uuid(7)) @db.Uuid
  contractId        String       @db.Uuid
  name              String
  priority          Int          @default(0)
  vehicleType       VehicleType?
  city              String?
  state             String?
  baseCents         Int
  perKmCents        Int          @default(0)
  includedKm        Float        @default(0)
  perMinuteCents    Int          @default(0)
  perKgCents        Int          @default(0)
  includedKg        Float        @default(0)
  minimumCents      Int          @default(0)
  maximumCents      Int?
  nightSurchargeBps Int          @default(0)
  rainSurchargeBps  Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  contract CorporateContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_price_rules")
}

model CostCenter {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @db.Uuid
  companyId          String   @db.Uuid
  code               String
  name               String
  /// Limite de gasto por mês (entregas faturadas ou pagas com carteira); nulo = sem limite.
  monthlyBudgetCents Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("cost_centers")
}

/// Unidades e locais da empresa (filiais, CDs, clientes frequentes) para coletas, destinos e transferências.
model CompanyLocation {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  name         String
  /// Unidade própria (transferência entre unidades) ou endereço de terceiro.
  isUnit       Boolean  @default(true)
  contactName  String?
  contactPhone String?
  zipCode      String?
  street       String
  number       String
  complement   String?
  district     String?
  city         String
  state        String
  reference    String?
  lat          Float
  lng          Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("company_locations")
}

/// Chave de API da empresa (integração de sistemas). Só o hash é guardado; o segredo é mostrado uma vez.
model CompanyApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  companyId   String    @db.Uuid
  name        String
  /// Início visível da chave (identificação).
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String    @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_api_keys")
}

// -----------------------------------------------------------------------------
// Entregas em lote e rotas
// -----------------------------------------------------------------------------

enum DeliveryBatchStatus {
  VALIDATING
  READY
  CONFIRMED
  CANCELED
  FAILED
}

enum DeliveryBatchSource {
  CSV
  XLSX
  API
}

enum BatchItemStatus {
  PENDING
  VALID
  INVALID
  CREATED
}

model DeliveryBatch {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @db.Uuid
  companyId     String              @db.Uuid
  number        Int
  name          String?
  source        DeliveryBatchSource
  fileName      String?
  status        DeliveryBatchStatus @default(VALIDATING)
  /// Coleta de todas as entregas do lote (endereço da empresa ou de uma unidade).
  pickup        Json
  pickupLat     Float
  pickupLng     Float
  locationId    String?             @db.Uuid
  scheduledFor  DateTime?
  paymentMethod PaymentMethod
  costCenterId  String?             @db.Uuid
  /// Agrupa as entregas em rotas (tarefas com várias paradas para um entregador).
  planRoutes    Boolean             @default(true)
  itemsCount    Int                 @default(0)
  validCount    Int                 @default(0)
  invalidCount  Int                 @default(0)
  totalFeeCents Int                 @default(0)
  routesCount   Int                 @default(0)
  error         String?
  createdById   String              @db.Uuid
  confirmedAt   DateTime?
  confirmedById String?             @db.Uuid
  canceledAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company    Company             @relation(fields: [companyId], references: [id])
  items      DeliveryBatchItem[]
  routes     DeliveryRoute[]
  deliveries Delivery[]

  @@unique([tenantId, number])
  @@index([companyId, createdAt])
  @@map("delivery_batches")
}

model DeliveryBatchItem {
  id           String          @id @default(uuid(7)) @db.Uuid
  batchId      String          @db.Uuid
  row          Int
  externalRef  String?
  status       BatchItemStatus @default(PENDING)
  /// Linha normalizada (destinatário, endereço, carga, observações, centro de custo).
  data         Json
  errors       String[]
  /// Destino resolvido (com coordenadas) e cotação.
  dropoff      Json?
  vehicleType  VehicleType?
  distanceKm   Float?
  durationMin  Int?
  feeCents     Int?
  payoutCents  Int?
  costCenterId String?         @db.Uuid
  deliveryId   String?         @unique @db.Uuid
  createdAt    DateTime        @default(now())

  batch DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, row])
  @@map("delivery_batch_items")
}

enum RouteStatus {
  PLANNED
  DISPATCHING
  ASSIGNED
  COMPLETED
  SPLIT
  CANCELED
}

/// Rota (tarefa): várias entregas com a mesma coleta, em ordem otimizada, oferecidas a um único entregador.
model DeliveryRoute {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @db.Uuid
  companyId      String      @db.Uuid
  batchId        String      @db.Uuid
  sequence       Int
  status         RouteStatus @default(PLANNED)
  vehicleType    VehicleType
  stopsCount     Int
  distanceKm     Float
  durationMin    Int
  feeCents       Int
  payoutCents    Int
  leadDeliveryId String?     @db.Uuid
  driverId       String?     @db.Uuid
  assignedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  batch      DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([batchId, sequence])
  @@index([tenantId, status])
  @@map("delivery_routes")
}

// -----------------------------------------------------------------------------
// Entregas recorrentes
// -----------------------------------------------------------------------------

model RecurringDelivery {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @db.Uuid
  companyId         String        @db.Uuid
  name              String
  pickupLocationId  String?       @db.Uuid
  dropoffLocationId String?       @db.Uuid
  /// Destino avulso (quando não é um local cadastrado).
  dropoff           Json?
  /// Dias da semana (0 = domingo) e horário local da entrega.
  weekdays          Int[]
  time              String
  startsOn          DateTime      @db.Date
  endsOn            DateTime?     @db.Date
  itemCategory      ItemCategory  @default(OTHER)
  itemDescription   String?
  weightKg          Float?
  notes             String?
  proofMethod       ProofMethod?
  paymentMethod     PaymentMethod
  costCenterId      String?       @db.Uuid
  isActive          Boolean       @default(true)
  createdById       String        @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    RecurringRun[]

  @@index([tenantId, isActive])
  @@index([companyId])
  @@map("recurring_deliveries")
}

/// Uma ocorrência gerada (ou que falhou) — idempotente por data.
model RecurringRun {
  id           String   @id @default(uuid(7)) @db.Uuid
  recurrenceId String   @db.Uuid
  /// Data local da ocorrência (AAAA-MM-DD).
  occursOn     String
  scheduledFor DateTime
  deliveryId   String?  @db.Uuid
  error        String?
  createdAt    DateTime @default(now())

  recurrence RecurringDelivery @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, occursOn])
  @@map("recurring_runs")
}

// -----------------------------------------------------------------------------
// Faturamento
// -----------------------------------------------------------------------------

enum InvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  CANCELED
}

model Invoice {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @db.Uuid
  companyId              String        @db.Uuid
  contractId             String        @db.Uuid
  number                 Int
  periodStart            DateTime
  periodEnd              DateTime
  status                 InvoiceStatus @default(ISSUED)
  deliveriesCount        Int
  deliveriesCents        Int
  minimumAdjustmentCents Int           @default(0)
  totalCents             Int
  /// Resumo por centro de custo: [{ costCenterId, code, name, deliveries, amountCents }]
  byCostCenter           Json
  issuedAt               DateTime      @default(now())
  dueAt                  DateTime
  paidAt                 DateTime?
  paidReference          String?
  canceledAt             DateTime?
  cancelReason           String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  company    Company           @relation(fields: [companyId], references: [id])
  contract   CorporateContract @relation(fields: [contractId], references: [id])
  deliveries Delivery[]

  @@unique([tenantId, number])
  @@unique([contractId, periodStart])
  @@index([companyId, status])
  @@index([status, dueAt])
  @@map("invoices")
}

// =============================================================================
// FASE 8 — INTELIGÊNCIA (antifraude, previsões, anomalias e IA assistiva)
// =============================================================================

enum RiskSignalType {
  /// Várias contas no mesmo aparelho.
  SHARED_DEVICE
  /// Cupom de primeira compra em aparelho/endereço já usado por outra conta.
  COUPON_ABUSE
  /// Conta recém-criada com pedido de valor alto.
  NEW_ACCOUNT_HIGH_VALUE
  /// Muitos pedidos/solicitações em pouco tempo.
  ORDER_VELOCITY
  /// Pagamentos recusados em sequência.
  PAYMENT_FAILURES
  /// Vários cartões diferentes em pouco tempo (teste de cartões).
  CARD_TESTING
  /// Localização simulada no aparelho do entregador.
  MOCK_LOCATION
  /// Deslocamento impossível entre duas leituras de GPS.
  IMPOSSIBLE_SPEED
  /// Tentativa de concluir a entrega longe do destino.
  PROOF_FAR_FROM_DROPOFF
  /// Taxa de cancelamento muito acima do normal.
  ABNORMAL_CANCELLATIONS
  /// Entregador que desiste de entregas com frequência anormal.
  DRIVER_RELEASES
  /// Registrado manualmente pela equipe.
  MANUAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskCaseStatus {
  OPEN
  IN_REVIEW
  DISMISSED
  CONFIRMED
}

enum AnomalyKind {
  DEMAND_SPIKE
  DEMAND_DROP
  CANCELLATION_SPIKE
  PAYMENT_FAILURE_SPIKE
  DISPATCH_DELAY
}

enum AnomalySeverity {
  WARNING
  CRITICAL
}

enum AnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum SuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
  EXPIRED
}

/// Aparelho visto em uma conta: id de instalação do app ou cookie do navegador, guardado como hash.
model DeviceSighting {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  deviceHash  String
  userId      String   @db.Uuid
  lastIp      String?
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  logins      Int      @default(1)

  @@unique([tenantId, deviceHash, userId])
  @@index([userId])
  @@map("device_sightings")
}

/// Indício de risco com a evidência que o gerou. Os pontos somam no score (com decaimento no tempo).
model RiskSignal {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @db.Uuid
  userId         String         @db.Uuid
  type           RiskSignalType
  points         Int
  message        String
  details        Json?
  relatedUserIds String[]       @default([]) @db.Uuid
  orderId        String?        @db.Uuid
  deliveryId     String?        @db.Uuid
  paymentId      String?        @db.Uuid
  /// Evita registrar duas vezes o mesmo fato (ex.: "coupon:<orderId>").
  dedupeKey      String?
  caseId         String?        @db.Uuid
  createdAt      DateTime       @default(now())

  case RiskCase? @relation(fields: [caseId], references: [id])

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([caseId])
  @@map("risk_signals")
}

/// Score de risco atual da conta (0–100, decai com o tempo). Recalculado a cada sinal e diariamente.
model RiskProfile {
  userId        String    @id @db.Uuid
  tenantId      String    @db.Uuid
  score         Int       @default(0)
  level         RiskLevel @default(LOW)
  signals       Int       @default(0)
  lastSignalAt  DateTime?
  /// Conta revisada e liberada pela equipe: ações automáticas suspensas até esta data.
  trustedUntil  DateTime?
  trustedReason String?
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, level, score])
  @@map("risk_profiles")
}

/// Caso para revisão humana: aberto quando o score passa do limite configurado.
model RiskCase {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  number       Int
  userId       String         @db.Uuid
  status       RiskCaseStatus @default(OPEN)
  level        RiskLevel
  score        Int
  summary      String
  assigneeId   String?        @db.Uuid
  resolution   String?
  resolvedById String?        @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  signals RiskSignal[]

  @@unique([tenantId, number])
  @@index([tenantId, status, level])
  @@index([userId, status])
  @@map("risk_cases")
}

/// Previsão horária de demanda (entregas solicitadas) por cidade e necessidade de entregadores.
model DemandForecast {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @db.Uuid
  /// "cidade/uf" normalizado
  city            String
  hourStart       DateTime
  predicted       Float
  low             Float
  high            Float
  driversNeeded   Int
  /// Média de entregadores online na mesma hora das últimas semanas (amostras da torre).
  driversExpected Float?
  /// Realizado (preenchido depois da hora): entregas solicitadas e entregadores online.
  actual          Int?
  driversOnline   Float?
  generatedAt     DateTime @default(now())

  @@unique([tenantId, city, hourStart])
  @@index([tenantId, hourStart])
  @@map("demand_forecasts")
}

/// Calibração do tempo de entrega aprendida com o histórico (cidade × veículo × faixa horária).
model EtaCalibration {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @db.Uuid
  /// "cidade/uf" normalizado ou "*" (todas)
  city            String
  /// Tipo de veículo ou "*" (todos)
  vehicle         String
  /// Faixa horária local (0 madrugada, 1 manhã, 2 almoço, 3 tarde, 4 jantar, 5 noite) ou -1 (todas)
  band            Int
  /// Tempo real de trajeto ÷ tempo estimado pela rota.
  transitFactor   Float
  /// Medianas (min): atribuição → coleta e busca → atribuição.
  pickupMinutes   Float?
  dispatchMinutes Float?
  samples         Int
  /// Erro médio absoluto (min) da estimativa original e da calibrada, no mesmo período.
  maeBeforeMin    Float?
  maeAfterMin     Float?
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, city, vehicle, band])
  @@map("eta_calibrations")
}

/// Anomalia operacional detectada (volume fora da previsão, picos de cancelamento, falhas de pagamento...).
model OpsAnomaly {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @db.Uuid
  kind             AnomalyKind
  severity         AnomalySeverity
  status           AnomalyStatus   @default(OPEN)
  city             String?
  windowStart      DateTime
  windowEnd        DateTime
  observed         Float
  expected         Float
  zScore           Float
  message          String
  dedupeKey        String
  acknowledgedById String?         @db.Uuid
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@map("ops_anomalies")
}

/// Sugestão de adicional de preço gerada pela previsão de falta de entregadores (aplicação sempre humana).
model PricingSuggestion {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  city            String
  windowStart     DateTime
  windowEnd       DateTime
  surchargeBps    Int
  predicted       Float
  driversNeeded   Int
  driversExpected Float
  reason          String
  status          SuggestionStatus @default(PENDING)
  surchargeId     String?          @db.Uuid
  decidedById     String?          @db.Uuid
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, city, windowStart])
  @@index([tenantId, status, windowStart])
  @@map("pricing_suggestions")
}

/// Adicional de preço com data e hora (ex.: pico previsto): incide sobre o frete e sobre o repasse ao entregador.
model PricingSurcharge {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  /// "cidade/uf" normalizado ou null (todas as cidades)
  city         String?
  startsAt     DateTime
  endsAt       DateTime
  surchargeBps Int
  reason       String
  createdById  String    @db.Uuid
  canceledAt   DateTime?
  canceledById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([tenantId, startsAt, endsAt])
  @@map("pricing_surcharges")
}

/// Uso dos recursos de IA: auditoria, custo e supervisão.
model AiInteraction {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String?  @db.Uuid
  companyId    String?  @db.Uuid
  /// SUPPORT_DRAFT | COMPANY_ASSISTANT | REVIEW_ANALYSIS
  feature      String
  provider     String
  model        String?
  /// OK | REFUSED | ERROR
  status       String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, feature, createdAt])
  @@index([userId, createdAt])
  @@map("ai_interactions")
}
