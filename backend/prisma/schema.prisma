// Comunicados (promoções e avisos operacionais)
// -----------------------------------------------------------------------------

enum BroadcastAudience {
  CUSTOMERS
  DRIVERS
  COMPANY_USERS
}

enum BroadcastKind {
  MARKETING
  OPERATIONAL
}

model Broadcast {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @db.Uuid
  audience    BroadcastAudience
  kind        BroadcastKind
  title       String
  body        String
  channels    String[]
  city        String?
  status      String            @default("QUEUED")
  recipients  Int               @default(0)
  delivered   Int               @default(0)
  createdById String            @db.Uuid
  createdAt   DateTime          @default(now())
  finishedAt  DateTime?

  @@index([tenantId, createdAt])
  @@map("broadcasts")
}

// -----------------------------------------------------------------------------
// Contato (formulário público do portal)
// -----------------------------------------------------------------------------

enum ContactAudience {
  CUSTOMER
  COMPANY
  DRIVER
  PRESS
  OTHER
}

model ContactMessage {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @db.Uuid
  name        String
  email       String
  phone       String?
  audience    ContactAudience
  subject     String
  message     String
  ip          String?
  handledAt   DateTime?
  handledById String?         @db.Uuid
  createdAt   DateTime        @default(now())

  @@index([tenantId, handledAt, createdAt])
  @@map("contact_messages")
}

// -----------------------------------------------------------------------------
// Auditoria
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @db.Uuid
  actorId    String?  @db.Uuid
  /// Ex.: "auth.login", "company.approve", "user.block"
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
