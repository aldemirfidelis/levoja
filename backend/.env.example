# =============================================================================
# LevoJá API — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env com credenciais reais.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================
NODE_ENV=development
PORT=3333
APP_NAME=LevoJá
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
LOG_LEVEL=info
LOG_PRETTY=true
SWAGGER_ENABLED=true

# PostgreSQL (docker compose ou `pnpm db:embedded` — ambos na porta 5433)
DATABASE_URL=postgresql://levoja:levoja@localhost:5433/levoja
# Opcional em desenvolvimento; obrigatório em produção (cache, filas, rate limit, WebSocket multi-instância)
# REDIS_URL=redis://localhost:6379

DEFAULT_TENANT_SLUG=levoja

# Segurança
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DATA_ENCRYPTION_KEY=<base64 de 32 bytes>
DATA_HASH_KEY=<base64 de 32 bytes>
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
# METRICS_TOKEN=

# Arquivos: local (dev) ou s3 (MinIO, AWS S3, Cloudflare R2...)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=levoja
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# PUBLIC_FILES_BASE_URL=

# E-mail: log (imprime no console) ou smtp (Mailpit em dev: localhost:1025)
MAIL_DRIVER=log
# SMTP_HOST=localhost
# SMTP_PORT=1025
MAIL_FROM=LevoJá <nao-responda@levoja.local>

# Push: log ou expo
PUSH_DRIVER=log
# EXPO_ACCESS_TOKEN=

# Mapas: haversine (estimativa offline) ou osrm (rotas reais; requer OSRM_URL)
MAPS_PROVIDER=haversine
# OSRM_URL=https://router.project-osrm.org
# Geocodificação: none (usa coordenadas do app/portal) ou nominatim
GEOCODER=none
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Pagamentos online: none (apenas dinheiro), sandbox (simulado; proibido em produção) ou mercadopago
PAYMENT_GATEWAY=sandbox
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_PUBLIC_KEY=   # chave pública: tokenização do cartão nos apps/portal
MERCHANT_CITY=SAO PAULO
# Saques: manual (financeiro transfere e confirma no painel) ou sandbox (simulado; proibido em produção)
PAYOUT_PROVIDER=sandbox

# Ligação mascarada (cliente/loja/entregador sem expor telefones): none ou twilio
VOICE_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_CALLER_ID=+551130000000

# IA assistiva: none (recursos determinísticos) ou anthropic (Claude). A chave fica só no ambiente.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_TIMEOUT_MS=90000

# Seed: usuário Super Admin inicial (se a senha ficar vazia, uma senha aleatória é gerada e exibida uma vez)
SEED_ADMIN_EMAIL=admin@levoja.local
SEED_ADMIN_PASSWORD=
