# URL interna da API (servidor Next -> API)
API_URL=http://localhost:3333
# Tenant atendido por este portal (white label: um portal por tenant)
TENANT_SLUG=levoja
# URL pública deste portal (metadados, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública da API para o navegador (tempo real via WebSocket)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Endereços deste portal (vírgula). Outros domínios na raiz exibem a página da loja com marca própria.
PLATFORM_HOSTS=localhost,127.0.0.1
# Esquema do app do cliente (link "Pedir pelo app" nas páginas das lojas)
NEXT_PUBLIC_APP_SCHEME=levoja
