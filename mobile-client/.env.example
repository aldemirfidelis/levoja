# URL da API (sem /v1). No emulador Android use http://10.0.2.2:3333; em aparelho físico, o IP da máquina na rede.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333
# Portal web (termos, privacidade, redefinição de senha).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Tenant (white label). Vazio = padrão da API.
EXPO_PUBLIC_TENANT=
# Tiles do mapa (use um provedor contratado em produção; o OSM público tem limites de uso).
EXPO_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap
# Projeto EAS (push). Obtenha com: npx eas-cli@latest init
EAS_PROJECT_ID=
